{
  "name": "ferrolab",
  "private": true,
  "version": "1.0.0",
  "description": "FerroLab — Aplicativo web mobile-first de acompanhamento de musculação em tempo real voltado para força e perda de gordura, com ficha Upper/Lower 4 dias, progressão dupla inteligente, 1RM, aquecimento automático, gráficos de desempenho e conformidade LGPD.",
  "author": "Carlos Guedes <https://github.com/carlosguedes-dev>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:licenses": "node scripts/audit-licenses.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.1"
  }
}
